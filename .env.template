# ── DataRobot credentials ─────────────────────────────────────────────────────
# Not needed in a DataRobot codespace (ambient auth is used automatically).
# Required for local development.
# DATAROBOT_API_TOKEN=
# DATAROBOT_ENDPOINT=https://app.eu.datarobot.com/api/v2/

# Required for Pulumi deployments. Choose any alphanumeric passphrase.
PULUMI_CONFIG_PASSPHRASE=123

# ── Forecast deployment ───────────────────────────────────────────────────────
# ID of the WFM time-series deployment used for scoring.
# FORECAST_DEPLOYMENT_ID=

# ── Source datasets (DR AI Catalog) ──────────────────────────────────────────
# Pre-computed planned/actual feature datasets used by prepare_forecast_cache.py.
# Falls back to local CSV files in data/ when not set.
# PLANNED_DATASET_ID=
# ACTUAL_DATASET_ID=

# Scoring dataset for the live Forecast Key Data page.
# FORECAST_SCORING_DATASET_ID=

# Observed actual target values — used to overlay actuals on both chart pages.
# Falls back to frontend/data/actuals_lookup.csv when not set.
# ACTUALS_DATASET_ID=

# ── Series column ─────────────────────────────────────────────────────────────
# Column in the scoring dataset that identifies the time-series (e.g. TECH / ADMIN).
# Defaults to "SKILL".
# COMPARISON_SERIES_COL=SKILL

# ── LLM for AI-generated summaries ───────────────────────────────────────────
# Option A: Azure OpenAI (direct) — fastest to set up.
# All three vars must be set; API version defaults to 2024-02-01 if omitted.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-02-01

# Option B: DataRobot-hosted TextGen deployment (no external keys needed).
# Deploy a TextGen model in DR, then set the deployment ID below.
# Also set LLM=DEPLOYED_LLM in infra/settings_generative.py.
# TEXTGEN_DEPLOYMENT_ID=
# CHAT_MODEL_NAME=datarobot-deployed-llm
